APP_NAME = TOS Wallet
APP_VERSION_COMMON = 1.0.0

BUNDLE_IDENTIFIER = $(BASE_BUNDLE_IDENTIFIER)
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER)
WIDGET_PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER).widget
INTENTS_PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_IDENTIFIER).intents

APP_GROUP_IDENTIFIER = group.$(BASE_BUNDLE_IDENTIFIER)
KEYCHAIN_ACCESS_GROUP = $(BASE_BUNDLE_IDENTIFIER).shared

ASSOCIATED_DOMAIN_APPLINKS_FIRST = applinks:app.tos.network
ASSOCIATED_DOMAIN_APPLINKS_SECOND = applinks:tos.network

PLATFORM = ios

TERMS_OF_SERVICE_URL = https:/$()/tos.network/terms.html
PRIVACY_POLICY_URL = https:/$()/tos.network/privacy
TONKEEPER_SWAP_URL = https:/$()/swap-widget.tos.network
